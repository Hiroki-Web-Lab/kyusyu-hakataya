{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only --autostash 2>&1 | tail -1 || true",
            "timeout": 30,
            "statusMessage": "git pull 中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ]
  }
}
